<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Burning Down | Scrum Dungeon</title>

    <link rel="stylesheet" href="/assets/css/main.css" />
    <link rel="stylesheet" href="/assets/css/burningdown.css" />
    <link rel="icon" type="image/x-icon" href="/assets/img/favicon.ico" />
  </head>

  <body class="pagina-burningdown">
    <%- include('partials/alert') %> 
    <%- include('partials/header') %>

    <main class="burningdown-container">
      <section class="burningdown-header">
        <div class="title-box">
          <h1>Burning Down</h1>

          <p>
            Nas chamas do
            <span class="glossario" data-g="burning-down">Burning Down</span>

            você pode verificar seu desempenho na jornada de Scrum Dungeon e
            retomar sua aventura de onde parou.
          </p>
        </div>
      </section>

      <section class="burningdown-content">
        <div class="burningdown-left">
          <div class="fogueira-card" aria-label="Checkpoint de progresso">
            <span class="brasa brasa-1" aria-hidden="true"></span>
            <span class="brasa brasa-2" aria-hidden="true"></span>
            <span class="brasa brasa-3" aria-hidden="true"></span>
            <img
              src="/assets/img/fogueira_burningdown_progresso.png"
              alt="Fogueira do Burning Down"
            />
            <p>Checkpoint da jornada</p>
          </div>
        </div>

        <div class="burningdown-right">
          <div class="chapter-box">
            <span>Capítulo atual:</span>
            <strong id="capituloAtual">01</strong>
          </div>

          <section
            class="burndown-panel"
            aria-label="Grafico de progresso Burning Down"
          >
            <div class="burndown-panel__header">
              <span>Desafios restantes</span>
              <strong id="restanteTotal">10</strong>
            </div>

            <div class="burndown-chart" aria-hidden="true">
              <svg viewBox="0 0 420 190" role="img">
                <path
                  class="burndown-grid"
                  d="M36 24H390M36 70H390M36 116H390M36 162H390"
                />
                <path
                  class="burndown-ideal"
                  d="M42 26L128 60L214 94L300 128L386 162"
                />
                <polyline
                  id="linhaBurningdownAtual"
                  class="burndown-atual"
                  points="42,26 128,60 214,94 300,128 386,162"
                />
              </svg>

              <div class="burndown-pontos" id="pontosBurningdown">
                <span>I</span>
                <span>II</span>
                <span>III</span>
                <span>IV</span>
                <span>V</span>
              </div>
            </div>
          </section>

          <div class="stats-box">
            <div class="stat">
              <span id="historiasCompletas">0/5</span>
              <p>Histórias completas</p>
            </div>

            <div class="stat">
              <span id="desafiosCompletos">0/5</span>
              <p>Desafios completos</p>
            </div>

            <div class="stat">
              <span id="porcentagemTotal">0%</span>
              <p>Conteúdo concluído</p>
            </div>

            <div class="stat">
              <div
                id="vidasBurningdown"
                class="burningdown-valor vidas-container"
              ></div>
              <p>Tentativas da run</p>
            </div>

            <div class="stat">
              <span id="tentativasGastas">0</span>
              <p>Tentativas gastas</p>
            </div>
          </div>

          <button class="btn-retomar" id="btnRetomarAventura" type="button">
            Retomar aventura
          </button>
        </div>
      </section>
    </main>

    <%- include('partials/navegacao_inferior') %> <%- include('partials/footer')
    %>

    <script src="/assets/js/audio.js"></script>
    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/burningdown.js"></script>
  </body>
</html>
