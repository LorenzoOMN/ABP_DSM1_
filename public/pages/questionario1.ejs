<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="/assets/css/main.css" />
    <link rel="stylesheet" href="/assets/css/questionario1.css" />
    <link rel="icon" type="image/x-icon" href="/assets/img/favicon.ico" />
    <!-- Título será atualizado via JS -->
    <title id="page-title">Questionário | Scrum Dungeon</title>
  </head>

  <body class="pagina-questionario" data-questionario-numero="1">
    <%- include('partials/header') %> <%- include('partials/botao_voltar') %>
    <%- include('partials/alert') %>

    <main class="corpo-questionario">
      <section class="tela">
        <section class="boss-box">
          <div class="boss-conteudo">
            <div class="boss-info">
              <span class="boss-label">BOSS</span>

              <!-- ID para atualizar via JS -->
              <h1 class="boss-nome" id="boss-nome">Carregando...</h1>

              <div class="boss-hp-area">
                <div class="boss-hp-barra">
                  <div id="boss-hp-fill" class="boss-hp-fill"></div>
                </div>

                <span id="boss-hp-texto" class="boss-hp-texto"> 100% </span>
              </div>
            </div>

            <div class="boss-imagem-area">
              <!-- ID para atualizar via JS -->
              <img
                src=""
                alt="Boss do Questionário"
                class="boss-imagem"
                id="bossImagem"
                data-boss-src=""
              />

              <div id="damage-float"></div>
            </div>
          </div>

          <div class="battle-status">
            <div class="progresso-textos">
              <span class="progresso-subtitulo">Progresso</span>
              <strong id="texto-progresso">Questão 1 de 10</strong>
            </div>

            <div
              class="barra-container"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              aria-label="Progresso atual do questionário"
            >
              <div
                id="progresso-dinamico"
                class="barra-preenchimento"
                style="width: 0%"
              ></div>
            </div>

            <div class="timer-box">
              <span class="timer-icone">⏳</span>
              <span id="timer-questao" class="timer-valor">20:00</span>
            </div>
          </div>
        </section>

        <section class="questao-box" aria-labelledby="enunciado-questao">
          <p class="dificuldade">
            Dificuldade:
            <strong id="texto-dificuldade">--</strong>
          </p>

          <div class="linha"></div>

          <p id="enunciado-questao" class="questao">Carregando pergunta...</p>

          <div
            id="imagem-questao-container"
            class="imagem-questao-container"
          ></div>
        </section>

        <p class="selecione">Selecione a alternativa correta</p>

        <section
          class="respostas"
          role="group"
          aria-label="Alternativas da questão"
        >
          <button type="button" class="botaoresposta" data-alternativa="a">
            <span class="quadradinho">
              <span class="letraresposta">A</span>
            </span>
            <span class="resposta">Carregando...</span>
          </button>

          <button type="button" class="botaoresposta" data-alternativa="b">
            <span class="quadradinho">
              <span class="letraresposta">B</span>
            </span>
            <span class="resposta">Carregando...</span>
          </button>

          <button type="button" class="botaoresposta" data-alternativa="c">
            <span class="quadradinho">
              <span class="letraresposta">C</span>
            </span>
            <span class="resposta">Carregando...</span>
          </button>

          <button type="button" class="botaoresposta" data-alternativa="d">
            <span class="quadradinho">
              <span class="letraresposta">D</span>
            </span>
            <span class="resposta">Carregando...</span>
          </button>
        </section>

        <section class="botoesdenavegacao">
          <button type="button" class="confirmar">Confirmar Resposta</button>
        </section>
      </section>
    </main>

    <%- include('partials/navegacao_inferior') %> <%- include('partials/footer')
    %>

    <script src="/assets/js/audio.js"></script>
    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/questionario1.js"></script>
  </body>
</html>
