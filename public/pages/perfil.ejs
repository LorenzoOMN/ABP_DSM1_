<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="../assets/css/main.css" />
  <link rel="stylesheet" href="/assets/css/perfil.css" />
  <title>Perfil</title>
</head>
<body>
  <%- include('./partials/header') %>
  <%- include('./partials/botao_voltar') %>
  <%- include('./partials/alert') %>

  <main class="perfil-container">
    <!-- O LIVRO (Container Principal) -->
    <section class="livro-perfil">
      
      <!-- PÁGINA ESQUERDA: Perfil -->
      <div class="pagina-esquerda">
        <h1 class="titulo-pagina">Perfil do Jogador</h1>

        <div class="area-perfil">
          <!-- Avatar -->
          <div class="avatar-wrapper" id="avatarContainer">
            <img id="avatarImg" src="/assets/img/avatares/default.png" alt="Avatar" class="avatar-img">
            <div class="avatar-border"></div> <!-- Borda decorativa CSS -->
          </div>

          <!-- Dados do Usuário -->
          <div class="dados-usuario">
            <h3 id="nomeUsuario">Carregando...</h3>
            <span id="emailUsuario">Carregando...</span>
            
            <div class="modulo-box">
              <span>Módulo Atual:</span>
              <strong id="capituloAtual">-</strong>
            </div>
          </div>
        </div>

        <!-- Botão ADM (Canto inferior) -->
        <a id="botaoDev" class="botao-adm" href="/admin">
          <img src="/assets/img/botao_adm.png" alt="ADM" class="botao-adm-img">
        </a>
      </div>

      <!-- PÁGINA DIREITA: Configurações -->
      <div class="pagina-direita">
        <h1 class="titulo-pagina">Configurações</h1>

        <div class="lista-configuracoes">
          <!-- Música -->
          <div class="item-config">
            <span>Música</span>
            <div id="toggleMusica" class="toggle"></div>
          </div>

          <!-- Efeitos -->
          <div class="item-config">
            <span>Efeitos Sonoros</span>
            <div id="toggleEfeitos" class="toggle"></div>
          </div>
        </div>
      </div>

    </section>
  </main>

  <script src="../assets/js/audio.js"></script>
  <script src="../assets/js/main.js"></script>
  <script src="../assets/js/perfil.js"></script>
  <%- include('./partials/navegacao_inferior') %>
</body>
</html>
