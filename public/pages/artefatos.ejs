<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sala dos Artefatos | Scrum Quest</title>

  <!-- CSS -->
  <link rel="stylesheet" href="/assets/css/main.css" />
  <link rel="stylesheet" href="/assets/css/artefatos.css" />
</head>

<body>
  <%- include('partials/alert') %>
  <%- include('partials/header') %>
  <%- include('partials/botao_voltar') %>

  <main class="artefatos-container">
    <!-- TÍTULO DA SEÇÃO -->
    <section class="section-title-box">
      <h1 class="section-title">SALA DOS ARTEFATOS</h1>
    </section>

    <!-- CONTEÚDO PRINCIPAL -->
    <section class="artefatos-content">
      <!-- COLUNA ESQUERDA -->
      <div class="artefatos-left">
        <p class="intro-text">
          A cada <strong>sprint</strong> completada um artefato será
          desbloqueado, use seus conhecimentos ancestrais para enfrentar os
          desafios e recuperar todos.
        </p>
        <div class="side-image">
          <img src="/assets/img/artefatos.png" alt="Artefatos do Scrum" />
        </div>
      </div>

      <!-- COLUNA DIREITA: Título Artefato + Carrossel + Descrição -->
      <div class="artefatos-right">
        
        <!-- Título Dinâmico do Artefato (inicialmente vazio) -->
        <h2 class="artefato-title" id="nomeArtefato">Carregando...</h2>

        <!-- CARROSSEL (container vazio - JS preenche) -->
        <div class="carousel-large">
          <button class="carousel-arrow prev" aria-label="Anterior">‹‹</button>

          <div class="carousel-frame" id="carousel-frame">
            <!-- Conteúdo será inserido dinamicamente pelo artefatos.js -->
            <p style="color: var(--text-muted); text-align: center; padding: 2rem;">
              Carregando artefatos...
            </p>
          </div>

          <button class="carousel-arrow next" aria-label="Próximo">››</button>
        </div>

        <!-- DESCRIÇÃO (inicialmente vazia - JS preenche) -->
        <div class="artefato-description" id="descricaoArtefato">
          <p style="color: var(--text-muted); text-align: center;">
            Selecione um artefato para ver os detalhes.
          </p>
        </div>

      </div>
    </section>
  </main>

  <%- include('partials/navegacao_inferior') %>
  <%- include('partials/footer') %>

  <!-- Scripts -->
  <script src="../assets/js/main.js"></script>
  <script src="/assets/js/artefatos.js"></script>
</body>

</html>